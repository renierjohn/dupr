{
  "name": "renify",
  "private": true,
  "scripts": {
    "livereload": "livereload --exclusions node_modules/ --exts 'css,js,twig,theme,apng,avif,gif,jpg,jpeg,jfif,pjpeg,pjp,png,svg,webp'"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "livereload": "^0.9.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.97.3"
  },
  "scripts": {
    "build:sass": "sass sass:css --no-source-map",
    "build:postcss": "postcss css/*.css --use autoprefixer -d css/",
    "build": "npm-run-all build:sass build:postcss",
    "dev": "npm-run-all --parallel watch:*",
    "watch:sass": "sass sass:css --watch --no-source-map",
    "watch:postcss": "postcss css/*.css --use autoprefixer -d css/ --watch"
  },
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT"
}
