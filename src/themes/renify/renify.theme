<?php

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Component\Utility\UrlHelper;

/**
 * @file
 * Functions to support theming in the Renify theme.
 */

/**
 * Implements hook_page_attachments_alter().
 */
function renify_page_attachments_alter(array &$attachments) {
  $request = \Drupal::request();
  $raw_query = $request->query->all();

  // 1. Define your "Allowed List" of parameters
  $allowed_params = ['ref', 'filter', 'page'];

  // 2. Filter the incoming query to ONLY include allowed keys
  $filtered_query = array_intersect_key($raw_query, array_flip($allowed_params));

  if (!empty($filtered_query)) {
    $safe_params = [];
    foreach ($filtered_query as $key => $value) {
      // Basic sanitation for the value
      if (is_string($value)) {
        $safe_params[$key] = Html::escape($value);
      }
    }

    // 3. Update the canonical link
    foreach ($attachments['#attached']['html_head'] as $key => $head_element) {
      if (isset($head_element[1]) && $head_element[1] === 'canonical_url') {

        $current_href = $attachments['#attached']['html_head'][$key][0]['#attributes']['href'];

        // Build the safe query string
        $query_string = UrlHelper::buildQuery($safe_params);
        $separator = (str_contains($current_href, '?')) ? '&' : '?';

        $attachments['#attached']['html_head'][$key][0]['#attributes']['href'] = $current_href . $separator . $query_string;

        // 4. Update Cache Contexts specifically for these parameters
        // This is more efficient than the generic 'url.query_args'
        foreach (array_keys($safe_params) as $param_name) {
          $attachments['#cache']['contexts'][] = 'url.query_args:' . $param_name;
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function renify_preprocess_html(array &$variables): void {

}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function renify_preprocess_page(array &$variables): void {

}


/**
 * Implements template_preprocess_node().
 */
function renify_preprocess_node(&$variables) {
  $node = $variables['node'];

  // 1. Check if the field exists and is empty
  if ($node->hasField('field_image') && $node->get('field_image')->isEmpty()) {

    // 2. Define the path to your default image
    // This assumes your image is at /themes/YOUR_THEME/images/default.jpg
    $theme_path = \Drupal::service('extension.list.theme')->getPath('renify');
    $default_image_url = '/' . $theme_path . '/images/placeholder.jpg';

    // 3. Pass the URL to a new variable for the template
    $variables['default_image_url'] = $default_image_url;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view.
 */
function renify_theme_suggestions_views_view_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $id = $view->storage->id();
  $display_id = $view->current_display;

  // Add a suggestion based on the view ID and display ID
  // Result: views-view--my-view-id--block-1.html.twig
  $suggestions[] = 'views_view__' . $id . '__' . $display_id;
}
